# Normalise to LF in the repository so `dist/action.js` stays byte-identical to a
# fresh build on every platform (a test asserts this), and so Dockerfile/YAML
# fixtures parse the same on Windows and Linux CI runners.
* text=auto eol=lf

# Generated bundle — keep it out of diffs and language stats.
dist/action.js linguist-generated=true -diff

# Collapsed in pull requests and excluded from the language bar. Dependabot
# opens these weekly and the churn is machine-written, not reviewable by eye.
package-lock.json linguist-generated=true
